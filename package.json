{
  "name": "oubao-winter-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-fonts.mjs",
    "prebuild": "node scripts/prepare-fonts.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "assets": "node scripts/prepare-assets.mjs",
    "vendor": "node scripts/prepare-page-flip.mjs",
    "test": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{ts,json}\""
  },
  "dependencies": {
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "lucide-react": "^0.468.0",
    "page-flip": "2.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.8.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0"
  }
}
